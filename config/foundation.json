{
  "$schema": "../schemas/config/foundation.schema.json",
  "schemaVersion": 1,
  "project": {
    "agentId": "mira-finance",
    "displayName": "Mira",
    "phase": "F17A"
  },
  "workspace": {
    "path": "/root/.workspaces/mira-finance",
    "isolation": "dedicated-workspace"
  },
  "features": {
    "database": true,
    "documentGeneration": true,
    "googleDrive": true,
    "whatsApp": true,
    "claims": true,
    "supplierInvoices": true,
    "reports": true,
    "corrections": true,
    "customerDelivery": true
  },
  "logging": {
    "directory": "logs",
    "format": "jsonl",
    "redactSecrets": true
  },
  "optionalIntegrations": {
    "database": "configured",
    "documentTemplates": "configured",
    "googleDrive": "configured",
    "whatsApp": "configured",
    "customerDelivery": "prepared"
  },
  "operations": {
    "minimumFreeBytes": 268435456,
    "minimumFreeRatio": 0.05,
    "logRotationMaximumBytes": 5242880,
    "logRotationRetained": 5,
    "temporaryFileMaximumAgeHours": 24,
    "interruptedIssuanceMinutes": 30
  }
}
