{
  "$schema": "../schemas/config/foundation.schema.json",
  "schemaVersion": 1,
  "project": {
    "agentId": "mira-finance",
    "displayName": "Mira",
    "phase": "F4"
  },
  "workspace": {
    "path": "/root/.workspaces/mira-finance",
    "isolation": "dedicated-workspace"
  },
  "features": {
    "database": true,
    "documentGeneration": false,
    "googleDrive": false,
    "whatsApp": false
  },
  "logging": {
    "directory": "logs",
    "format": "jsonl",
    "redactSecrets": true
  },
  "optionalIntegrations": {
    "database": "configured",
    "documentTemplates": "configured",
    "googleDrive": "not-configured",
    "whatsApp": "not-configured"
  }
}
