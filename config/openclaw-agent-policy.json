{
  "agentId": "mira-finance",
  "displayName": "Mira",
  "workspace": "/root/.workspaces/mira-finance",
  "skills": [
    "mira-finance"
  ],
  "tools": {
    "profile": "minimal",
    "alsoAllow": [
      "read",
      "mira_finance_health",
      "mira_finance_prepare_delivery",
      "mira_finance_confirm_delivery"
    ],
    "deny": [
      "write",
      "edit",
      "apply_patch",
      "exec",
      "process",
      "browser",
      "gateway",
      "nodes",
      "message",
      "sessions_list",
      "sessions_history",
      "sessions_send",
      "sessions_spawn",
      "web_search",
      "web_fetch"
    ],
    "fs": {
      "workspaceOnly": true
    },
    "elevated": {
      "enabled": false
    },
    "message": {
      "allowCrossContextSend": false,
      "crossContext": {
        "allowWithinProvider": false,
        "allowAcrossProviders": false
      },
      "broadcast": {
        "enabled": false
      }
    }
  },
  "sandbox": {
    "mode": "off",
    "workspaceAccess": "rw",
    "scope": "agent"
  },
  "healthTool": "mira_finance_health"
}
