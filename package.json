{
  "name": "mira-finance",
  "version": "0.1.0",
  "private": true,
  "description": "Isolated OpenClaw Finance Agent workspace foundation",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "validate:config": "node scripts/validate-config.mjs",
    "health": "node scripts/health-check.mjs",
    "health:json": "node scripts/health-check.mjs --json",
    "templates:normalize": "node scripts/normalize-templates.mjs",
    "templates:validate": "node scripts/validate-templates.mjs",
    "templates:render-test": "node scripts/render-template-fixtures.mjs",
    "templates:sample-myr": "node scripts/render-template-fixtures.mjs --fixture tests/fixtures/sample-myr-invoice.json --template invoice-myr --output-root generated/samples",
    "templates:sample-all": "node scripts/render-template-fixtures.mjs --fixture tests/fixtures/sample-two-item-all-currencies.json --output-root generated/samples-all",
    "invoices:render-qa": "node scripts/render-invoice-qa.mjs",
    "drive:health": "node scripts/drive-health-check.mjs",
    "drive:upload": "node scripts/drive-upload.mjs",
    "whatsapp:configure": "node scripts/configure-whatsapp-routing.mjs",
    "whatsapp:verify": "node scripts/verify-openclaw-f10.mjs",
    "pilot:f11": "node scripts/run-f11-pilot.mjs",
    "pilot:f11:verify": "node scripts/verify-f11-pilot.mjs",
    "claims": "node scripts/claim-receipt.mjs",
    "supplier-invoices": "node scripts/supplier-invoice.mjs",
    "reports": "node scripts/finance-reports.mjs",
    "db:verify-equivalent": "node scripts/verify-ledger-equivalence.mjs",
    "db:migrate": "node scripts/migrate-database.mjs",
    "db:migrate:down": "node scripts/migrate-database.mjs --down",
    "db:check": "node scripts/check-database.mjs",
    "db:backup": "node scripts/backup-database.mjs",
    "registry": "node scripts/finance-registry.mjs",
    "test": "node --test tests/unit/*.test.mjs tests/integration/*.test.mjs tests/regression/*.test.mjs"
  },
  "dependencies": {
    "@xmldom/xmldom": "0.9.10",
    "docxtemplater": "3.69.3",
    "pizzip": "3.2.0"
  }
}
