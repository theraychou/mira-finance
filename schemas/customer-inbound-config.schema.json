{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "customer-inbound-config.schema.json",
  "title": "Private Mira inbound customer reply configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "enabled", "autoReply", "confirmationTtlMinutes", "maxMessageCharacters", "email", "whatsApp"],
  "properties": {
    "$schema": {"type": "string", "const": "../schemas/customer-inbound-config.schema.json"},
    "schemaVersion": {"type": "integer", "const": 1},
    "enabled": {"type": "boolean"},
    "autoReply": {"type": "boolean"},
    "confirmationTtlMinutes": {"type": "integer", "minimum": 5, "maximum": 30},
    "maxMessageCharacters": {"type": "integer", "minimum": 256, "maximum": 12000},
    "email": {
      "type": "object", "additionalProperties": false,
      "required": ["enabled", "account", "client", "from", "searchQuery", "maximumResults"],
      "properties": {
        "enabled": {"type": "boolean"},
        "account": {"type": "string", "format": "email", "maxLength": 254},
        "client": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{1,63}$"},
        "from": {"type": "string", "format": "email", "maxLength": 254},
        "searchQuery": {"type": "string", "minLength": 1, "maxLength": 200},
        "maximumResults": {"type": "integer", "minimum": 1, "maximum": 50}
      }
    },
    "whatsApp": {
      "type": "object", "additionalProperties": false,
      "required": ["enabled"],
      "properties": {
        "enabled": {"type": "boolean"},
        "account": {"type": ["string", "null"], "maxLength": 64}
      }
    }
  }
}
