{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "invoice-draft.schema.json",
  "title": "Mira invoice draft input",
  "type": "object",
  "additionalProperties": false,
  "required": ["customer_id", "business_entity_id", "currency", "issue_date", "payment_terms_days", "service_date", "payment_terms", "line_items", "discount", "tax"],
  "properties": {
    "customer_id": {"type": "integer", "minimum": 1},
    "business_entity_id": {"type": "integer", "minimum": 1},
    "currency": {"enum": ["MYR", "SGD", "USD"]},
    "issue_date": {"type": "string", "format": "date"},
    "payment_terms_days": {"type": "integer", "minimum": 0, "maximum": 3650},
    "service_date": {"type": "string", "format": "date"},
    "purchase_order_number": {"type": ["string", "null"]},
    "payment_terms": {"type": "string", "minLength": 1},
    "notes": {"type": ["string", "null"]},
    "source_channel": {"type": ["string", "null"]},
    "source_message_reference": {"type": ["string", "null"]},
    "line_items": {"type": "array", "minItems": 1, "maxItems": 7, "items": {"type": "object"}},
    "discount": {"type": "object"},
    "tax": {"type": "object", "properties": {"mode": {"const": "NONE"}}, "required": ["mode"]}
  }
}
