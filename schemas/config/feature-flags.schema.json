    "database": {"type": "boolean", "const": true},
    "documentGeneration": {"type": "boolean", "const": true},
    "googleDrive": {"type": "boolean", "const": true},
    "whatsApp": {"type": "boolean", "const": true},
    "claims": {"type": "boolean", "const": true},
    "supplierInvoices": {"type": "boolean", "const": true},
    "reports": {"type": "boolean", "const": true},
    "corrections": {"type": "boolean", "const": true},
    "customerDelivery": {"type": "boolean", "const": true},
    "customerInbound": {"type": "boolean", "const": true},
    "customerAdministration": {"type": "boolean", "const": true},
    "customerSheetMirror": {"type": "boolean", "const": true},
    "invoiceDriveOnlyStorage": {"type": "boolean", "const": true}
