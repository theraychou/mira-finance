{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "customer-delivery-config.schema.json",
  "title": "Private Mira outbound customer delivery configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "enabled", "defaultChannel", "confirmationTtlMinutes", "email", "whatsApp", "signature"],
  "properties": {
    "$schema": {"type": "string", "const": "../schemas/customer-delivery-config.schema.json"},
    "schemaVersion": {"type": "integer", "const": 1},
    "enabled": {"type": "boolean"},
    "defaultChannel": {"type": "string", "const": "EMAIL"},
    "confirmationTtlMinutes": {"type": "integer", "minimum": 5, "maximum": 30},
    "email": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "account", "client", "from"],
      "properties": {
        "enabled": {"type": "boolean"},
        "account": {"type": "string", "format": "email", "maxLength": 254},
        "client": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{1,63}$"},
        "from": {"type": "string", "format": "email", "maxLength": 254},
        "replyTo": {"type": ["string", "null"], "format": "email", "maxLength": 254}
      }
    },
    "whatsApp": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {
        "enabled": {"type": "boolean"},
        "account": {"type": ["string", "null"], "maxLength": 64}
      }
    },
    "signature": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {"type": "string", "minLength": 1, "maxLength": 120}
    }
  }
}
