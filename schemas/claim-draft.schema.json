{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "claim-draft.schema.json",
  "title": "Mira claim draft",
  "type": "object",
  "additionalProperties": false,
  "required": ["transaction_date", "merchant", "description", "category", "currency", "subtotal_minor", "tax_minor", "total_minor", "business_purpose", "client_initials"],
  "properties": {
    "transaction_date": {"type": ["string", "null"], "format": "date"},
    "merchant": {"type": ["string", "null"], "maxLength": 200},
    "description": {"type": ["string", "null"], "maxLength": 500},
    "category": {"type": ["string", "null"], "pattern": "^[a-z][a-z0-9-]{1,63}$"},
    "client_or_project": {"type": ["string", "null"], "maxLength": 200},
    "currency": {"type": ["string", "null"], "enum": ["MYR", "SGD", "USD", null]},
    "subtotal_minor": {"type": ["integer", "null"], "minimum": 0},
    "tax_minor": {"type": "integer", "minimum": 0},
    "total_minor": {"type": ["integer", "null"], "minimum": 0},
    "payment_method": {"type": ["string", "null"], "maxLength": 100},
    "business_purpose": {"type": ["string", "null"], "maxLength": 500},
    "client_initials": {"type": ["string", "null"], "pattern": "^[A-Z0-9]{1,8}$"}
  }
}

