{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quotation-draft.schema.json",
  "title": "Mira Finance quotation draft input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "customer_id", "business_entity_id", "currency", "issue_date", "validity_days",
    "service_date", "title", "payment_terms", "line_items", "discount", "tax"
  ],
  "properties": {
    "customer_id": {"type": ["integer", "null"], "minimum": 1},
    "business_entity_id": {"type": ["integer", "null"], "minimum": 1},
    "currency": {"enum": ["MYR", "SGD", "USD"]},
    "issue_date": {"type": "string", "format": "date"},
    "validity_days": {"type": "integer", "minimum": 1, "maximum": 3650},
    "service_date": {"type": ["string", "null"]},
    "title": {"type": ["string", "null"]},
    "description": {"type": ["string", "null"]},
    "payment_terms": {"type": ["string", "null"]},
    "notes": {"type": ["string", "null"]},
    "source_channel": {"type": ["string", "null"]},
    "source_message_reference": {"type": ["string", "null"]},
    "line_items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["description", "quantity", "unit_price_minor"],
        "properties": {
          "description": {"type": "string", "minLength": 1},
          "quantity": {"type": "string", "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]{1,6})?$"},
          "unit": {"type": ["string", "null"]},
          "unit_price_minor": {"type": "integer", "minimum": 0}
        }
      }
    },
    "discount": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["type"], "properties": {"type": {"const": "NONE"}}},
        {"type": "object", "additionalProperties": false, "required": ["type", "amount_minor"], "properties": {"type": {"const": "FIXED"}, "amount_minor": {"type": "integer", "minimum": 0}}},
        {"type": "object", "additionalProperties": false, "required": ["type", "basis_points"], "properties": {"type": {"const": "PERCENTAGE"}, "basis_points": {"type": "integer", "minimum": 0, "maximum": 10000}}}
      ]
    },
    "tax": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["mode"], "properties": {"mode": {"const": "NONE"}}},
        {"type": "object", "additionalProperties": false, "required": ["mode", "tax_rule_id"], "properties": {"mode": {"const": "RULE"}, "tax_rule_id": {"type": "integer", "minimum": 1}}}
      ]
    }
  }
}
